NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1

# Simulator Database (Dedicated, completely separate from CRM)
MONGODB_URI=mongodb://localhost:27017/airline_crm_simulator

# Redis for BullMQ queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=3

# CRM Integration (Points to existing Airline CRM in TEST or LOCAL mode)
CRM_ENVIRONMENT=TEST
CRM_BASE_URL=http://localhost:5000
CRM_SOCKET_URL=http://localhost:5000
CRM_ALLOWED_HOSTS=localhost,127.0.0.1
CRM_SERVICE_TOKEN=

# Simulator Safety Guardrails
SIMULATOR_MAX_CONCURRENCY=5
SIMULATOR_MAX_TURNS=20
SIMULATOR_MAX_DURATION_MS=600000
SIMULATOR_MAX_MESSAGES=50
SIMULATOR_MAX_TOKEN_BUDGET=100000

# Dashboard Frontend URL
FRONTEND_URL=http://localhost:5173
