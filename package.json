{
  "name": "airline-bot-api",
  "version": "1.0.0",
  "description": "Airline AI Customer Simulation Platform Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node src/queues/simulation.worker.js",
    "seed:personas": "node seeds/personas.seed.js",
    "seed:scenarios": "node seeds/scenarios.seed.js",
    "seed:customers": "node seeds/customers.seed.js",
    "seed": "node seeds/personas.seed.js && node seeds/scenarios.seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "airline",
    "simulation",
    "ai",
    "customer-simulator",
    "crm-testing"
  ],
  "author": "Bitmax Tech",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
